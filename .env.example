# -----------------------------------------------------------------------------
# internal-llm — environment variables
# Copy this file to `.env` and adjust the values. Never commit `.env`.
# Read by docker-compose.yml (whole app in containers) and docker-compose.dev.yml (PostgreSQL
# only, for local development). The API run with `npm run start:dev` reads api/.env instead.
# -----------------------------------------------------------------------------

# --- Web --------------------------------------------------------------------
# Port published on the host by the `web` container (the only exposed port).
WEB_PORT=8080

# --- Database (docker-compose.yml) -------------------------------------------
# Required, empty on purpose: Compose refuses to start without it. Letters and digits only
# (it ends up in the API's connection URL). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
# User created in PostgreSQL on its first start (a later change needs a new volume).
POSTGRES_USER=internal_llm
# Database created in PostgreSQL on its first start (a later change needs a new volume).
POSTGRES_DB=internal_llm

# --- API (docker-compose.yml) ------------------------------------------------
# Required, empty on purpose: Compose refuses to start without it. Signs the session JWTs
# (min. 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Session lifetime in seconds (JWT + cookie). Default: 604800 (7 days).
JWT_EXPIRES_IN_SECONDS=604800

# true only when the app is served over HTTPS (cookie flagged `Secure`).
COOKIE_SECURE=false

# Maximum length of a user message, in characters.
MAX_MESSAGE_LENGTH=32000

# --- Logging (docker-compose.yml) --------------------------------------------
# Minimum level of the API logs, one JSON object per line on the standard output:
# fatal, error, warn, info, debug, trace, or silent to turn them off.
LOG_LEVEL=info

# --- LLM (docker-compose.yml) ------------------------------------------------
# Provider implementation: `mock` (fake streamed answers, no model server needed).
LLM_PROVIDER=mock

# Stream tokens when the provider supports it (true), or wait for the full answer (false).
LLM_STREAM=true

# Non-streaming: max duration of a call. Streaming: max silence before/between tokens.
LLM_TIMEOUT_MS=60000

# Optional system prompt prepended to every conversation (not stored in the database).
LLM_SYSTEM_PROMPT=

# Recorded LLM calls (table llm_calls) older than this many days are deleted every day at
# 03:00 UTC. Minimum 1. Conversations and messages are never purged.
# Run the purge by hand with `docker compose exec api node dist/cli/purge-llm-calls.js`.
LLM_CALL_RETENTION_DAYS=90

# --- Development (docker-compose.dev.yml) -------------------------------------
# Host port of the development PostgreSQL. Change it when 5432 is already taken (e.g. by
# another project), then use the same port in DATABASE_URL and TEST_DATABASE_URL (api/.env).
POSTGRES_PORT=5432

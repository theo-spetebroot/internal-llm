# -----------------------------------------------------------------------------
# internal-llm — environment variables
# Copy this file to `.env` and adjust the values. Never commit `.env`.
# Each section is completed as the corresponding feature lands.
# -----------------------------------------------------------------------------

# --- Web --------------------------------------------------------------------
# Port published on the host by the `web` container (the only exposed port).
WEB_PORT=8080

# --- Development (docker-compose.dev.yml) -------------------------------------
# Host port of the development PostgreSQL. Change it when 5432 is already taken (e.g. by
# another project), then use the same port in DATABASE_URL and TEST_DATABASE_URL (api/.env).
POSTGRES_PORT=5432

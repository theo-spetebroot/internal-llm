{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in; sets the session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body"
          },
          "401": {
            "description": "Invalid email or password"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Session cookie cleared"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired session"
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/api/conversations": {
      "get": {
        "operationId": "ConversationsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The user's conversations, most recently active first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Conversation"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired session"
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "conversations"
        ]
      },
      "post": {
        "operationId": "ConversationsController_create",
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conversation created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body"
          },
          "401": {
            "description": "Missing, invalid or expired session"
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/conversations/{id}": {
      "get": {
        "operationId": "ConversationsController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The conversation and its messages, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired session"
          },
          "404": {
            "description": "No such conversation for this user"
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "conversations"
        ]
      },
      "patch": {
        "operationId": "ConversationsController_rename",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateConversationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversation renamed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body"
          },
          "401": {
            "description": "Missing, invalid or expired session"
          },
          "404": {
            "description": "No such conversation for this user"
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "conversations"
        ]
      },
      "delete": {
        "operationId": "ConversationsController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Conversation and its messages deleted"
          },
          "401": {
            "description": "Missing, invalid or expired session"
          },
          "404": {
            "description": "No such conversation for this user"
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/conversations/{id}/messages": {
      "post": {
        "operationId": "ChatController_send",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-sent events, each `data` being a JSON `ChatEvent`: `start`, then `delta`*, then `done` or `error`. Comment lines (`: ping`) are sent as heartbeats.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ChatEvent"
                }
              }
            }
          },
          "400": {
            "description": "Empty or too long message"
          },
          "401": {
            "description": "Missing, invalid or expired session"
          },
          "404": {
            "description": "No such conversation for this user"
          },
          "409": {
            "description": "An answer is already being generated"
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/stats/me": {
      "get": {
        "operationId": "StatsController_me",
        "parameters": [
          {
            "name": "days",
            "required": false,
            "in": "query",
            "schema": {
              "default": 30,
              "description": "Length of the period, in days, today included",
              "type": "integer",
              "enum": [
                7,
                30,
                90
              ]
            }
          },
          {
            "name": "tz",
            "required": false,
            "in": "query",
            "schema": {
              "default": "UTC",
              "description": "IANA time zone the days are cut in (default UTC)",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The caller's own usage over the period: LLM calls, tokens, response times and a per-day series, all taken from the recorded LLM calls, so deleting a conversation changes none of them. A call without a token figure (the model server was never reached, or the call predates the token columns) counts as a request and adds no token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserStats"
                }
              }
            }
          },
          "400": {
            "description": "Invalid `days` or `tz`"
          },
          "401": {
            "description": "Missing, invalid or expired session"
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "stats"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API and database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "internal-llm API",
    "description": "REST + SSE API of internal-llm, a web chat interface for a self-hosted LLM.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastMessageAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "createdAt",
          "updatedAt",
          "lastMessageAt"
        ],
        "additionalProperties": false
      },
      "CreateConversationRequest": {
        "default": {},
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "ConversationDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastMessageAt": {
            "type": "string",
            "format": "date-time"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          }
        },
        "required": [
          "id",
          "title",
          "createdAt",
          "updatedAt",
          "lastMessageAt",
          "messages"
        ],
        "additionalProperties": false
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/MessageRole"
          },
          "content": {
            "type": "string"
          },
          "interrupted": {
            "type": "boolean"
          },
          "promptTokens": {
            "nullable": true,
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "completionTokens": {
            "nullable": true,
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "tokensEstimated": {
            "nullable": true,
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "interrupted",
          "promptTokens",
          "completionTokens",
          "tokensEstimated",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "MessageRole": {
        "type": "string",
        "enum": [
          "user",
          "assistant",
          "system"
        ]
      },
      "UpdateConversationRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "title"
        ]
      },
      "SendMessageRequest": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "content"
        ],
        "description": "At most MAX_MESSAGE_LENGTH characters (default 32000) once trimmed."
      },
      "ChatEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ChatStartEvent"
          },
          {
            "$ref": "#/components/schemas/ChatDeltaEvent"
          },
          {
            "$ref": "#/components/schemas/ChatDoneEvent"
          },
          {
            "$ref": "#/components/schemas/ChatErrorEvent"
          }
        ]
      },
      "ChatStartEvent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "start"
            ]
          },
          "conversation": {
            "$ref": "#/components/schemas/Conversation"
          },
          "userMessage": {
            "$ref": "#/components/schemas/Message"
          }
        },
        "required": [
          "type",
          "conversation",
          "userMessage"
        ],
        "additionalProperties": false
      },
      "ChatDeltaEvent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "delta"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "content"
        ],
        "additionalProperties": false
      },
      "ChatDoneEvent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "done"
            ]
          },
          "assistantMessage": {
            "$ref": "#/components/schemas/Message"
          }
        },
        "required": [
          "type",
          "assistantMessage"
        ],
        "additionalProperties": false
      },
      "ChatErrorEvent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "LLM_UNAVAILABLE",
              "LLM_TIMEOUT",
              "LLM_ERROR",
              "INTERNAL"
            ]
          },
          "message": {
            "type": "string"
          },
          "assistantMessage": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Message"
              }
            ]
          }
        },
        "required": [
          "type",
          "code",
          "message",
          "assistantMessage"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ],
        "additionalProperties": false
      },
      "UserStats": {
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/StatsPeriod"
          },
          "requests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tokens": {
            "type": "object",
            "properties": {
              "prompt": {
                "$ref": "#/components/schemas/StatsTokenCounts"
              },
              "completion": {
                "$ref": "#/components/schemas/StatsTokenCounts"
              }
            },
            "required": [
              "prompt",
              "completion"
            ],
            "additionalProperties": false
          },
          "averages": {
            "type": "object",
            "properties": {
              "durationMs": {
                "nullable": true,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "timeToFirstTokenMs": {
                "nullable": true,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "durationMs",
              "timeToFirstTokenMs"
            ],
            "additionalProperties": false
          },
          "outcomes": {
            "type": "object",
            "properties": {
              "completed": {
                "$ref": "#/components/schemas/StatsOutcome"
              },
              "interrupted": {
                "$ref": "#/components/schemas/StatsOutcome"
              },
              "error": {
                "$ref": "#/components/schemas/StatsOutcome"
              },
              "timeout": {
                "$ref": "#/components/schemas/StatsOutcome"
              }
            },
            "required": [
              "completed",
              "interrupted",
              "error",
              "timeout"
            ],
            "additionalProperties": false
          },
          "daily": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatsDailyPoint"
            }
          }
        },
        "required": [
          "period",
          "requests",
          "tokens",
          "averages",
          "outcomes",
          "daily"
        ],
        "additionalProperties": false
      },
      "StatsPeriod": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "timeZone": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "description": "First day of the period, YYYY-MM-DD"
          },
          "to": {
            "type": "string",
            "description": "Last day of the period (today), YYYY-MM-DD"
          }
        },
        "required": [
          "days",
          "timeZone",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "StatsTokenCounts": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "estimated": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Counted with a heuristic (about 4 characters per token)"
          },
          "reported": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Reported by the LLM provider"
          }
        },
        "required": [
          "total",
          "estimated",
          "reported"
        ],
        "additionalProperties": false
      },
      "StatsOutcome": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Share of the requests of the period (0 to 1)"
          }
        },
        "required": [
          "count",
          "rate"
        ],
        "additionalProperties": false
      },
      "StatsDailyPoint": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Calendar day, YYYY-MM-DD, in the requested time zone"
          },
          "requests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "promptTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completionTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "date",
          "requests",
          "promptTokens",
          "completionTokens"
        ],
        "additionalProperties": false
      }
    }
  }
}

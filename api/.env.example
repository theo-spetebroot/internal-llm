# -----------------------------------------------------------------------------
# API — local development (`npm run start:dev`). Copy to `api/.env`; never commit it.
# In Docker, these variables come from the root `.env` via docker-compose.yml.
# -----------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# HTTP port of the API (the Vite dev server proxies /api to it).
PORT=3000

# PostgreSQL started by `docker compose -f docker-compose.dev.yml up -d`.
# The port must match POSTGRES_PORT in the root `.env` (default 5432).
DATABASE_URL=postgresql://llmchat:llmchat@localhost:5432/llmchat

# Database used by `npm test` (created and migrated automatically). Same port as above.
TEST_DATABASE_URL=postgresql://llmchat:llmchat@localhost:5432/llmchat_test

# Secret used to sign session JWTs (min. 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Session lifetime in seconds (JWT + cookie). Default: 604800 (7 days).
JWT_EXPIRES_IN_SECONDS=604800

# true only when the app is served over HTTPS (cookie flagged `Secure`).
COOKIE_SECURE=false

# --- Chat ---------------------------------------------------------------------
# Maximum length of a user message, in characters.
MAX_MESSAGE_LENGTH=32000

# --- LLM ----------------------------------------------------------------------
# Provider implementation: `mock` (fake streamed answers, no model server needed).
LLM_PROVIDER=mock

# Stream tokens when the provider supports it (true), or wait for the full answer (false).
LLM_STREAM=true

# Non-streaming: max duration of a call. Streaming: max silence before/between tokens.
LLM_TIMEOUT_MS=60000

# Optional system prompt prepended to every conversation (not stored in the database).
LLM_SYSTEM_PROMPT=

# Recorded LLM calls (table llm_calls) older than this many days are deleted every day at
# 03:00, server time. Minimum 1. Conversations and messages are never purged.
# Run the purge by hand with `npm run llm-calls:purge`.
LLM_CALL_RETENTION_DAYS=90

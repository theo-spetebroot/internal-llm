// Prisma schema — the datasource URL lives in prisma.config.ts (Prisma 7+).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum LlmCallOutcome {
  COMPLETED
  INTERRUPTED
  ERROR
  TIMEOUT
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  displayName   String         @map("display_name")
  // Admins see instance-wide stats and manage accounts. Promoted from the CLI only.
  role          UserRole      @default(USER)
  createdAt     DateTime       @default(now()) @map("created_at")
  conversations Conversation[]
  llmCalls      LlmCall[]

  @@map("users")
}

model Conversation {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  // Time of the last message (user or assistant); createdAt until the first one. Orders the
  // sidebar: unlike updatedAt, it does not move when the conversation is renamed.
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  messages      Message[]
  llmCalls      LlmCall[]

  // Serves the sidebar query: "conversations of a user, most recently active first".
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  // True when generation was stopped before completion (client abort); content is then partial.
  interrupted    Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")

  // Token counts of an assistant message; NULL on the other roles. `tokensEstimated` tells
  // whether they come from a heuristic (true) or were reported by the provider (false), so
  // real figures can replace estimates later without changing the schema.
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  tokensEstimated  Boolean? @map("tokens_estimated")

  // Serves "messages of a conversation in chronological order".
  @@index([conversationId, createdAt])
  @@map("messages")
}

// One row per LLM call, written when the call ends. Holds no prompt or answer text: those live
// in `messages`. Kept when a conversation is deleted (the conversation link becomes NULL), and
// removed with its user.
model LlmCall {
  id                 String         @id @default(cuid())
  userId             String         @map("user_id")
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId     String?        @map("conversation_id")
  conversation       Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  provider           String
  startedAt          DateTime       @map("started_at")
  durationMs         Int            @map("duration_ms")
  // Null when no token was produced (error or timeout before the first token).
  timeToFirstTokenMs Int?           @map("time_to_first_token_ms")
  outcome            LlmCallOutcome
  // Error code (`LLM_ERROR`, `LLM_TIMEOUT`…) when the outcome is ERROR or TIMEOUT.
  errorCode          String?        @map("error_code")

  // Token usage of the call, kept here (not only on the messages) so that it survives the
  // deletion of a conversation, like the call itself. `tokensEstimated` tells whether the counts
  // come from a heuristic (true) or were reported by the provider (false). All three are NULL
  // when the call has no figure (the provider was never reached, or the call was interrupted
  // before any token), and on the rows recorded before these columns existed: no backfill.
  promptTokens       Int?           @map("prompt_tokens")
  completionTokens   Int?           @map("completion_tokens")
  tokensEstimated    Boolean?       @map("tokens_estimated")

  // Serves the per-user stats, and the global stats and retention purge by date.
  @@index([userId, startedAt])
  @@index([startedAt])
  @@map("llm_calls")
}

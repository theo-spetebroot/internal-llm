{
  "name": "llm-chat-api",
  "version": "0.1.0",
  "private": true,
  "description": "REST + SSE API for llm-chat (NestJS, Prisma, PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start:dev": "nest start --watch -b swc",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "user:create": "tsx src/cli/create-user.ts",
    "postinstall": "prisma generate",
    "openapi:export": "nest build && node dist/openapi/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/passport": "12.0.2",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@scarf/scarf": false,
    "@swc/core@1.16.22": true,
    "argon2@0.45.2": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  }
}

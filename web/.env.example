# -----------------------------------------------------------------------------
# Web — local development (`npm run dev`). Copy to `web/.env.local`; never commit it.
# Only read by the Vite dev server: nothing here ends up in the browser bundle.
# -----------------------------------------------------------------------------

# Where the dev server proxies /api (the API started with `npm run start:dev` in api/).
# Default: http://localhost:3000. Change it when the API runs on another PORT.
API_PROXY_TARGET=http://localhost:3000
